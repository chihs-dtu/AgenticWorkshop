{
  "$schema": "https://opencode.ai/config.json",
  "model": "dtu/gptoss",
  "small_model": "dtu/gptoss",
  "provider": {
    "dtu": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DTU",
      "models": {
        "qwen36": {
          "name": "Qwen 3.6 35B-A3B",
          "provider": {
            "api": "https://teaching.healthtech.dtu.dk/workshop/qwen36"
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen38": {
          "name": "Qwen 3.8 27B FP8",
          "provider": {
            "api": "https://teaching.healthtech.dtu.dk/workshop/qwen38"
          },
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "mistral": {
          "name": "Mistral Nemo 12B",
          "provider": {
            "api": "https://teaching.healthtech.dtu.dk/workshop/mistral"
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "gptoss": {
          "name": "GPT-OSS 20B",
          "provider": {
            "api": "https://teaching.healthtech.dtu.dk/workshop/gptoss"
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "mcp": {
    "duckdb": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "mcp-server-motherduck@1.0.8",
        "--db-path",
        "exercises/03-mcp/data/pdb.duckdb",
        "--max-rows",
        "100",
        "--max-chars",
        "8000"
      ],
      "timeout": 60000
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask"
  }
}
